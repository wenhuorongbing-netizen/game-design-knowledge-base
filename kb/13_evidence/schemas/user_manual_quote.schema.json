{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gdkb.user_manual_quote.v1",
  "title": "GDKB UserManualQuote",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "entity_type",
    "quote_id",
    "work_id",
    "source_document_id",
    "quote_text",
    "quote_length_words",
    "location",
    "user_commentary",
    "why_it_matters",
    "related_concepts",
    "related_cards",
    "source_basis",
    "confidence",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "entity_type": { "const": "UserManualQuote" },
    "quote_id": { "type": "string", "minLength": 1 },
    "manual_quote_id": { "type": "string" },
    "work_id": { "type": "string", "minLength": 1 },
    "source_document_id": { "type": "string", "minLength": 1 },
    "sidecar_id": { "type": "string" },
    "quote_text": { "type": "string" },
    "quote_length_words": { "type": "integer", "minimum": 1, "maximum": 80 },
    "location": { "type": "string" },
    "user_commentary": { "type": "string" },
    "why_it_matters": { "type": "string" },
    "related_concepts": { "type": "array", "items": { "type": "string" } },
    "related_cards": { "type": "array", "items": { "type": "string" } },
    "user_provided": { "const": true },
    "automated_extraction": { "const": false },
    "generated_from_source_body": { "const": false },
    "source_basis": { "enum": ["user_manual_quote"] },
    "confidence": { "enum": ["weak", "medium", "strong", "user_interpretation"] },
    "status": { "enum": ["draft", "accepted_user_quote", "needs_review", "rejected"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
