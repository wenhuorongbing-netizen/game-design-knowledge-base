{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gdkb.evidence_ref.v1",
  "title": "GDKB EvidenceRef",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "entity_type",
    "evidence_ref_id",
    "evidence_type",
    "source_basis",
    "confidence",
    "evidence_scope",
    "supports_entity_ids",
    "supports_claim_ids",
    "limitations",
    "reviewer",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "entity_type": { "const": "EvidenceRef" },
    "evidence_ref_id": { "type": "string", "minLength": 1 },
    "evidence_type": {
      "enum": [
        "legal_sidecar",
        "user_manual_note",
        "user_manual_quote",
        "open_source_reference",
        "official_metadata_reference",
        "derived_note",
        "audit_reference"
      ]
    },
    "source_basis": {
      "enum": [
        "open_fulltext",
        "official_metadata",
        "user_legal_file",
        "user_manual_note",
        "user_manual_quote",
        "derived_from_user_note",
        "derived_from_public_metadata",
        "metadata_only",
        "unsupported_draft"
      ]
    },
    "confidence": { "enum": ["verified", "strong", "medium", "weak", "unsupported_draft", "user_interpretation", "ai_hypothesis"] },
    "evidence_scope": { "type": "string", "minLength": 1 },
    "source_document_id": { "type": "string" },
    "work_id": { "type": "string" },
    "sidecar_id": { "type": "string" },
    "manual_note_id": { "type": "string" },
    "manual_quote_id": { "type": "string" },
    "open_source_reference_id": { "type": "string" },
    "official_metadata_reference_id": { "type": "string" },
    "supports_entity_ids": { "type": "array", "items": { "type": "string" } },
    "supports_claim_ids": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": ["string", "array"] },
    "reviewer": { "type": "string" },
    "status": { "enum": ["draft", "pending_review", "approved", "rejected", "superseded", "archived"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
