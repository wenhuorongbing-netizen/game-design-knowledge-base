{
  "schema_version": "bookos.ontology.v1",
  "updated_date": "2026-04-26",
  "governance": {
    "source_basis_required": true,
    "confidence_required": true,
    "source_ids_required_for_knowledge_objects": true,
    "claim_scope_required_for_claim_like_objects": true,
    "high_risk_body_ingest_allowed": false,
    "default_draft_basis": "unsupported_draft"
  },
  "phase_groups": [
    {
      "phase_id": "phase_project_direction",
      "name": "立项与方向",
      "purpose": "Decide what game should exist, who it serves, what it promises, and what should be excluded.",
      "typical_deliverables": ["vision_brief", "target_player_profile", "mvp_scope_cut", "risk_register", "design_pillars"],
      "domain_ids": ["play_theory", "player_experience", "player_psychology", "formal_elements", "prototyping", "business_pitch_release", "ethics_responsibility", "prompt_engineering_game_design"]
    },
    {
      "phase_id": "phase_core_play_systems",
      "name": "核心玩法与系统设计",
      "purpose": "Define repeatable play, core mechanics, loops, goals, rules, feedback, and player decisions.",
      "typical_deliverables": ["core_loop_diagram", "mechanic_spec", "system_map", "rules_table", "onboarding_sketch"],
      "domain_ids": ["rules_and_mechanics", "formal_elements", "systems_thinking", "loops_parts_wholes", "chance_skill_decisions", "game_feel", "prototyping", "playtesting"]
    },
    {
      "phase_id": "phase_numbers_economy",
      "name": "数值与经济设计",
      "purpose": "Shape resources, quantities, pacing, costs, rewards, scarcity, balance, and progression.",
      "typical_deliverables": ["economy_map", "resource_loop_diagram", "reward_table", "progression_curve", "balance_test_matrix"],
      "domain_ids": ["economy_and_balance", "systems_thinking", "loops_parts_wholes", "chance_skill_decisions", "playtesting", "business_pitch_release", "ethics_responsibility"]
    },
    {
      "phase_id": "phase_content_narrative",
      "name": "内容与叙事",
      "purpose": "Create meaning-bearing story, world, character, mission, dialogue, and content structures.",
      "typical_deliverables": ["world_bible", "narrative_premise", "quest_structure", "character_sheet", "dialogue_sample"],
      "domain_ids": ["narrative_story_structure", "worldbuilding", "character_design", "player_experience", "ui_ux_feedback", "ethics_responsibility"]
    },
    {
      "phase_id": "phase_art_ui_experience",
      "name": "美术 / UI / 体验表达",
      "purpose": "Make the game readable, expressive, responsive, coherent, accessible, and satisfying moment to moment.",
      "typical_deliverables": ["art_direction_brief", "hud_structure", "feedback_spec", "input_response_map", "readability_audit"],
      "domain_ids": ["game_feel", "input_response_context_polish", "ui_ux_feedback", "player_experience", "character_design", "space_level_design", "ethics_responsibility"]
    },
    {
      "phase_id": "phase_development_implementation",
      "name": "开发实现",
      "purpose": "Translate design into playable software, tools, data, runtime systems, and maintainable implementation.",
      "typical_deliverables": ["technical_design_spec", "prototype_plan", "state_machine_spec", "input_system_spec", "performance_risk_note"],
      "domain_ids": ["prototyping", "iteration_production", "loops_parts_wholes", "game_feel", "ui_ux_feedback", "prompt_engineering_game_design"]
    },
    {
      "phase_id": "phase_testing_acceptance_audit",
      "name": "测试 / 验收 / 审计",
      "purpose": "Validate assumptions, inspect quality, triage bugs, audit evidence, and decide acceptance.",
      "typical_deliverables": ["playtest_plan", "observation_log", "balance_report", "usability_audit", "acceptance_checklist"],
      "domain_ids": ["playtesting", "player_experience", "game_feel", "ui_ux_feedback", "economy_and_balance", "iteration_production", "prompt_engineering_game_design"]
    },
    {
      "phase_id": "phase_operations_release",
      "name": "运营与发布",
      "purpose": "Prepare launch, communicate value, sustain player interest, and learn from post-release behavior.",
      "typical_deliverables": ["release_checklist", "store_page_copy", "roadmap", "event_plan", "retention_review"],
      "domain_ids": ["business_pitch_release", "multiplayer_community", "player_psychology", "ethics_responsibility", "iteration_production", "prompt_engineering_game_design"]
    }
  ],
